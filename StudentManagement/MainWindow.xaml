<Window x:Class="StudentManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentManagement"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Поля ввода -->
        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Text="ФИО:"/>
            <TextBox x:Name="TxtFio" Margin="0,0,0,5"/>

            <TextBlock Text="Группа:"/>
            <TextBox x:Name="TxtGroup" Margin="0,0,0,5"/>

            <TextBlock Text="Дата рождения:"/>
            <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,5"/>

            <TextBlock Text="Телефон:"/>
            <TextBox x:Name="TxtPhone" Margin="0,0,0,5"/>

            <TextBlock Text="Ср. балл:"/>
            <TextBox x:Name="TxtMark" Margin="0,0,0,10"/>

            <Button Content="Добавить" Click="Add_Click" Height="30"/>
        </StackPanel>

        <!-- Таблица и удаление -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="GridStude" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="150"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="80"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="Ср. балл" Binding="{Binding Gpa}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Удалить" Click="Delete_Click" Grid.Row="1" Height="30" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
