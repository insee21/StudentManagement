<Window x:Class="StudentManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentManagement"
        mc:Ignorable="d"
        Title="Управление студентами" Height="500" Width="850">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: Поля ввода (Код Разработчика 1) -->
        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Text="ФИО:" FontWeight="Bold"/>
            <TextBox x:Name="TxtFio" Margin="0,0,0,5"/>

            <TextBlock Text="Группа:" FontWeight="Bold"/>
            <TextBox x:Name="TxtGroup" Margin="0,0,0,5"/>

            <TextBlock Text="Дата рождения:" FontWeight="Bold"/>
            <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,5"/>

            <TextBlock Text="Телефон:" FontWeight="Bold"/>
            <TextBox x:Name="TxtPhone" Margin="0,0,0,5"/>

            <TextBlock Text="Ср. балл:" FontWeight="Bold"/>
            <TextBox x:Name="TxtMark" Margin="0,0,0,15"/>

            <Button Content="Добавить" Click="Add_Click" Height="30" Background="#E1F5FE"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
     
                <RowDefinition Height="*"/>
         
                <RowDefinition Height="Auto"/>
      
                <RowDefinition Height="40"/>
  
            </Grid.RowDefinitions>

            <GroupBox Header="Поиск и Фильтрация" Grid.Row="0" Margin="0,0,0,10" Padding="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5,0">
                        <TextBlock Text="Поиск по ФИО:" FontSize="11" Foreground="Gray"/>
                        <TextBox x:Name="TxtSearch" Height="23"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Фильтр по группе:" FontSize="11" Foreground="Gray"/>
                        <TextBox x:Name="TxtFilterGroup" Height="23"/>
                    </StackPanel>

                    <Button Content="Найти" Click="Search_Click" Grid.Column="2" 
                            Width="70" Height="23" Margin="5,15,5,0" VerticalAlignment="Bottom"/>

                    <Button Content="Сбросить" Click="Reset_Click" Grid.Column="3" 
                            Width="70" Height="23" Margin="0,15,5,0" VerticalAlignment="Bottom"/>
                </Grid>
            </GroupBox>

            <DataGrid x:Name="GridStude" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="80"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="110"/>
                    <DataGridTextColumn Header="Ср. балл" Binding="{Binding Gpa}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="LblNotFoundError" Grid.Row="2" 
                       Text="Студенты с такими параметрами не найдены" 
                       Foreground="Red" FontWeight="Bold" Margin="5" 
                       HorizontalAlignment="Center" Visibility="Collapsed"/>
            <Button Content="Удалить выбранного студента" Click="Delete_Click" Grid.Row="3" Height="30" VerticalAlignment="Bottom" Background="#FFEBEE"/>
        </Grid>
    </Grid>
</Window>
